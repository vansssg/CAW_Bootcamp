# Railway / container env. Do not commit real secrets.
# Bind: Dockerfile uses --host 0.0.0.0 --port ${PORT}.
# Inside a container, DATABASE_URL host must be the postgres service name
# (or host.docker.internal), never localhost.

APP_ENV=production
PORT=3000
DATABASE_URL=
REDIS_URL=
LOG_LEVEL=info
JWT_SECRET=
CORS_ORIGIN=
API_KEY_A=
API_KEY_B=
IMAGE_TAG=
SEARCH_USE_POSTGRES=
JOB_PERSIST_DB=
